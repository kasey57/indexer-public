PORT=3000

# SQLite is the default. The parent folder is created automatically.
DB_DRIVER=sqlite
SQLITE_PATH=./data/indexing.sqlite

# For MySQL, set DB_DRIVER=mysql and provide these values instead:
# DB_DRIVER=mysql
# DB_HOST=
# DB_PORT=3306
# DB_NAME=
# DB_USER=
# DB_PASSWORD=
# DB_SSL=true

# Optional: authorize GET requests to /api?action=process-queue from a server scheduler.
# Generate a random value of at least 16 characters.
# CRON_SECRET=
